{
  "github": {
    "enabled": false
  },
  "headers": [
    {
      "source": "/iconos_civilflow/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|svg|ico|woff2?)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://va.vercel-scripts.com https://cdn.paddle.com; style-src 'self'; style-src-elem 'self' https://cdn.paddle.com https://sandbox-cdn.paddle.com 'sha256-DZJGI9GW1KarnkjWFGQEtAWrfY4TQZwE9gIsAtq6sTk='; style-src-attr 'unsafe-hashes' 'sha256-G1uQ2TdzPadBgZhbO2zOTrRdlDoq9BGEKzWJvICVQLo=' 'sha256-Z29WkVafffk4H/87Pln052+Z9XSPafMCUJvrH0WSxpM=' 'sha256-BKJzP3dU1V1cVZwOs23ngG9tPG4LdgjCR+1pJQmpx+U=' 'sha256-ET0BUt5sEVpoIgG1qTt57VnxpJOfKa7aXm9/pkiVoto='; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://va.vercel-scripts.com https://api.paddle.com https://sandbox-api.paddle.com https://buy.paddle.com https://sandbox-buy.paddle.com https://create-checkout.paddle.com https://sandbox-create-checkout.paddle.com; worker-src 'self' blob:; frame-src 'self' blob: https://www.youtube-nocookie.com https://player.vimeo.com https://buy.paddle.com https://sandbox-buy.paddle.com; object-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/civilbim",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/civilbim/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/civilmep",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/civilmep/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/restablecer",
      "destination": "/index.html"
    },
    {
      "source": "/perfil",
      "destination": "/index.html"
    },
    {
      "source": "/empresa",
      "destination": "/index.html"
    },
    {
      "source": "/welcome",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/planos",
      "destination": "/index.html"
    },
    {
      "source": "/catalogomaestro",
      "destination": "/index.html"
    },
    {
      "source": "/visor/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/dibujoRedes",
      "destination": "/index.html"
    },
    {
      "source": "/dibujoRedes/:proyectoId",
      "destination": "/index.html"
    },
    {
      "source": "/dibujoRedes/:proyectoId/:seccion",
      "destination": "/index.html"
    },
    {
      "source": "/dibujoRedes/:proyectoId/:seccion/:tab",
      "destination": "/index.html"
    },
    {
      "source": "/civilflowareatrabajo/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/civilmanagerareatrabajo/:path*",
      "destination": "/index.html"
    }
  ]
}

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_tu-key-aqui

# Enciende el gating de suscripciones (cliente + candados de la BD).
# La BD es el candado real: app_config('suscripciones_activas', true).
# Con 'false' (o sin esta variable) nadie queda bloqueado.
VITE_SUSCRIPCIONES=false

# Paddle.js usa únicamente un token público test_ (sandbox) o live_ (production).
# Definir ambos valores donde se vaya a habilitar el checkout.
VITE_PADDLE_ENVIRONMENT=
VITE_PADDLE_CLIENT_TOKEN=
# Solo Vite local en sandbox. Prueba el bloqueo de módulos con esta cuenta.
VITE_PADDLE_SANDBOX_USER_ID=

# Genera el informe de bundle (dist/stats.html) en el build.
VITE_ANALYZE=false

# Origen permitido por las funciones de pago (configurarlo también en Supabase).
# Local: http://localhost:5173 · Vercel preview: la URL del preview.
SITE_URL=http://localhost:5173

# Configurar solo en Supabase Edge, junto con PADDLE_API_KEY y PADDLE_WEBHOOK_SECRET
# del mismo entorno. Producción usa https://api.paddle.com.
PADDLE_API_BASE=https://sandbox-api.paddle.com
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Usuario dedicado para activar compras únicas de sandbox en el mismo Supabase.
# Si queda vacío, los eventos de sandbox solo sincronizan el espejo de Paddle.
PADDLE_SANDBOX_USER_ID=

# Correos transaccionales. Secrets de Supabase Edge, no variables VITE.
RESEND_API_KEY=
SUBSCRIPTION_EMAIL_FROM=
SUBSCRIPTION_EMAIL_CRON_SECRET=
